DATABASE_HOST=mysql-db
DATABASE_PORT=3306
DATABASE_NAME=blackbox
DATABASE_USER=appuser
DATABASE_PASSWORD=apppassword

# Development Reset Settings (DEV ONLY!)
DEV_FULL_RESET=false

USE_MINIO=true
DIFF_THRESHOLD=0.1
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=blackbox-configs
MINIO_USE_SSL=false

NFS_SERVER=192.168.70.149
NFS_SHARE_PATH=/srv/share
NFS_MOUNT_POINT=/mnt/nfs

SMB_SERVER=192.168.70.149
SMB_SHARE_NAME=share
SMB_MOUNT_POINT=/mnt/smb
SMB_USERNAME=guest
SMB_PASSWORD=
SMB_DOMAIN=WORKGROUP

# File Server Configuration
# Primary Server Configuration
FILE_SERVER_TYPE=nfs  # or smb
FILE_SERVER_ENABLED=false
MAX_FILE_SIZE_MB=1024
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30

# Secondary Server Configuration (optional)
FILE_SERVER_2_ENABLED=false
FILE_SERVER_2_TYPE=nfs
FILE_SERVER_2_SERVER=192.168.70.150
FILE_SERVER_2_SHARE_PATH=/srv/share
FILE_SERVER_2_MOUNT_POINT=/mnt/nfs2

# Local File System Configuration (optional)
LOCAL_FS_ENABLED=true
LOCAL_FS_PATH=/app/configs

REACT_APP_API_URL=http://localhost:8080