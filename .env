# ===========================================
# BlackBox — пример конфигурации
# Скопируйте в .env и при необходимости отредактируйте.
# Для запуска из Docker Hub укажите логин разработчика: DOCKERHUB_USER=логин
# ===========================================

# Docker Hub: логин, под которым опубликованы образы (только для docker-compose.hub.yml)
DOCKERHUB_USER=yourusername

# Фронтенд: URL API (при сборке nginx). Для работы через nginx оставьте /api
VITE_API_URL=/api

# MinIO (хранилище конфигов)
USE_MINIO=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=blackbox
MINIO_USE_SSL=false

# Scheduler: порог изменения для diff
DIFF_THRESHOLD=0.1
# Scheduler: интервал между сканированиями (секунды); отсчёт начинается после завершения полного сканирования
SCAN_INTERVAL_SECONDS=9999999

# Файловые серверы (если не используете — оставьте пустыми или false)
FILE_SERVER_TYPE=smb
FILE_SERVER_ENABLED=true
NFS_SERVER=
NFS_SHARE_PATH=/srv/share
NFS_MOUNT_POINT=/mnt/nfs
SMB_SERVER=192.168.0.3
SMB_SHARE_NAME=configs
SMB_MOUNT_POINT=
SMB_USERNAME=user
SMB_PASSWORD=180504
SMB_DOMAIN=WORKGROUP

# Локальная файловая система (если не используете)
LOCAL_FS_ENABLED=false
LOCAL_FS_PATH=