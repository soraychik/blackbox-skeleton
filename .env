# ===========================================
# BlackBox — конфигурация окружения
# Только параметры, необходимые для запуска контейнеров.
# Всё остальное настраивается через веб-интерфейс (Настройки).
# ===========================================

# Фронтенд: URL API при сборке nginx. Для работы через nginx оставьте /api
VITE_API_URL=/api

# Локальный администратор — для первого входа до настройки LDAP
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# База данных MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=blackbox
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# MinIO — требуется при старте контейнеров (до доступа к БД)
USE_MINIO=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=blackbox
MINIO_USE_SSL=false
