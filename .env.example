# ===========================================
# BlackBox — пример конфигурации
# Скопируйте в .env и при необходимости отредактируйте.
# Для запуска из Docker Hub укажите логин разработчика: DOCKERHUB_USER=логин
# ===========================================

# Docker Hub: логин, под которым опубликованы образы (только для docker-compose.hub.yml)
DOCKERHUB_USER=yourusername

# Фронтенд: URL API (при сборке nginx). Для работы через nginx оставьте /api
REACT_APP_API_URL=/api

# MinIO (хранилище конфигов)
USE_MINIO=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=blackbox
MINIO_USE_SSL=false

# Scheduler: порог изменения для diff
DIFF_THRESHOLD=0.1
# Scheduler: интервал между сканированиями (секунды); отсчёт начинается после завершения полного сканирования
SCAN_INTERVAL_SECONDS=30
# Scheduler: порт для принудительного сканирования (кнопка на дашборде)
SCHEDULER_TRIGGER_PORT=9090
# Api-web: URL планировщика для вызова принудительного сканирования (в Docker: http://scheduler:9090)
SCHEDULER_TRIGGER_URL=http://scheduler:9090

# Файловые серверы (если не используете — оставьте пустыми или false)
FILE_SERVER_TYPE=
FILE_SERVER_ENABLED=false
NFS_SERVER=
NFS_SHARE_PATH=
NFS_MOUNT_POINT=
SMB_SERVER=
SMB_SHARE_NAME=
SMB_MOUNT_POINT=
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=

# Локальная файловая система — папка с конфигами на хосте (для Docker: ./scheduler/configs маппится в /app/configs)
# Включите true, чтобы сканировать файлы из LOCAL_FS_PATH
LOCAL_FS_ENABLED=true
LOCAL_FS_PATH=/app/configs

# Таймауты и лимиты (по желанию)
MAX_FILE_SIZE_MB=50
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30
